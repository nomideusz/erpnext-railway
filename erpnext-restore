#!/bin/bash
# Restore a backup made by erpnext-backup, replacing the site's database and files:
#   erpnext-restore Mon              that weekday's backup from the Railway bucket
#   erpnext-restore /tmp/backup.tar  a backup tar already in the container
# Restart the service afterwards so every process picks up the restored site.
set -euo pipefail
[ $# = 1 ] || { sed -n '2,5p' "$0"; exit 2; }

cd /home/frappe/frappe-bench
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
if [ -f "$1" ]; then
  tar -C "$dir" -xf "$1"
else
  curl -fsS --aws-sigv4 "aws:amz:${S3_REGION:-auto}:s3" \
    -u "$S3_ACCESS_KEY_ID:$S3_SECRET_ACCESS_KEY" \
    "https://$S3_BUCKET.${S3_ENDPOINT#https://}/erpnext-$1.tar" | tar -C "$dir" -xf -
fi
chown -R frappe: "$dir"
set -- "$dir"/*-database.sql.gz "$dir"/*-erp-files.tgz "$dir"/*-private-files.tgz "$dir"/*-site_config_backup.json

# Passwords stored in ERPNext (email accounts, integrations) are encrypted with the
# site's key. Take the key from the backup, or a restore into a new deployment
# could not read them.
conf=sites/erp/site_config.json
jq --slurpfile b "$4" '.encryption_key = ($b[0].encryption_key // .encryption_key)' "$conf" > "$dir/conf"
cat "$dir/conf" > "$conf"

as_frappe=(setpriv --reuid=frappe --regid="$(id -g frappe)" --init-groups env HOME=/home/frappe)
"${as_frappe[@]}" bench --site erp restore "$1" --with-public-files "$2" \
  --with-private-files "$3" --db-root-username root --db-root-password "$DB_ROOT_PASSWORD" 2>&1
"${as_frappe[@]}" bench --site erp migrate 2>&1 | sed -u 's/.*\r//'
# bench restore keeps the scheduler setting of the site it replaced, which on a new
# deployment stays off until the setup wizard runs. The restored site's setup counts.
setup=$("${as_frappe[@]}" bench --site erp execute frappe.db.get_single_value \
  --args '["System Settings", "setup_complete"]')
[ "$setup" = 1 ] && "${as_frappe[@]}" bench --site erp enable-scheduler
echo "erpnext-restore: done; restart the service so every process picks up the restored site"
